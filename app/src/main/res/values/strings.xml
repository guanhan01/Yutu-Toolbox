    <string name="app_about_desc">A local toolbox for developers: app management, file browsing, web, network diagnostics, database, packet capture, decompilation, plus an MCP client and a built-in MCP server.</string>
    <string name="app_about_theme">Theme base: Material3 role system with HCT dynamic color; components: a self-drawn implementation of the Miuix visual spec.</string>
    <string name="app_about_section_compliance">Compliance</string>
    <string name="app_about_compliance1_title">Capture and decompilation are for authorized debugging</string>
    <string name="app_about_compliance1_subtitle">Use them only on apps you own or are authorized to test; never to crack someone else\'s app</string>
    <string name="app_about_compliance2_title">Data stays on this device</string>
    <string name="app_about_compliance2_subtitle">Nothing is uploaded by default; network requests only run when you trigger them</string>
    <string name="app_about_compliance3_title">HTTPS decryption requires a user CA</string>
    <string name="app_about_compliance3_subtitle">Apps on Android 7+ do not trust user CAs by default; assess the risk before installing one</string>

    <!-- 首启合规弹窗 -->
    <string name="app_compliance_title">Before you start</string>
    <string name="app_compliance_confirm">I understand</string>
    <string name="app_compliance_message">The packet capture (including HTTPS decryption) and decompilation features are only for learning and debugging apps you own or are explicitly authorized to test. Do not use them to crack or tamper with other people\'s apps. All data stays on this device; nothing is uploaded by default.</string>
    <string name="app_compliance_footer">Continuing means you accept the scope above.</string>
